{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amryadam-com",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // The Worker runs first so it can redirect www before any file is served.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "amryadam.com", "custom_domain": true },
    { "pattern": "www.amryadam.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
